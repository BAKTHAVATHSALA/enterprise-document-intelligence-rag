# Application Environment Configuration Example
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# OpenAI Settings
OPENAI_API_KEY=your_openai_api_key_here

# AWS Bedrock Settings
AWS_REGION=us-east-1
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v1

# Pinecone Vector Database Settings
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=enterprise-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_ENVIRONMENT=gcp-starter

# Neo4j Graph Database Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# LangSmith Observability Settings
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=distributed-rag

# PostgreSQL Database Settings
PGHOST=ep-your-pghost-here.aws.neon.tech
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=your_postgres_password_here
PGSSLMODE=require
PGCHANNELBINDING=require
DATABASE_URL=postgresql://neondb_owner:your_postgres_password_here@ep-your-pghost-here.aws.neon.tech/neondb?sslmode=require

